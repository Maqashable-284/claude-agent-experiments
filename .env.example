# ============================================
# Scoop AI Agent V3.1 - Environment Configuration
# ============================================

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Connection (optional - for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/scoop_db
MONGODB_DATABASE=scoop_db

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Agent Configuration
DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_TURNS=50
PERMISSION_MODE=acceptEdits

# Session Management
SESSION_TTL_SECONDS=1800  # 30 minutes

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# CORS Configuration
# Use "*" for development, comma-separated URLs for production
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# Claude Agent SDK Options (optional)
CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING=1
